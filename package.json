{
  "name": "human-error-game",
  "version": "0.7.0",
  "private": true,
  "description": "A one-screen microgame rush with a deterministic referee and optional replay-verified leaderboard.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Smkzz/humanerror.git"
  },
  "homepage": "https://github.com/Smkzz/humanerror#readme",
  "bugs": {
    "url": "https://github.com/Smkzz/humanerror/issues"
  },
  "keywords": [
    "game",
    "microgame",
    "browser-game",
    "deterministic",
    "hackathon",
    "open-source"
  ],
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test --test-concurrency=1 tests/*.test.mjs",
    "serve": "node scripts/serve.mjs",
    "check": "npm test && node scripts/audit.mjs",
    "verify:evidence": "node scripts/verify-release-evidence.mjs",
    "test:browser": "node scripts/build.mjs && python tests/v07_browser.py && python tests/v07_timed_browser.py"
  },
  "devDependencies": {
    "bun": "1.4.0",
    "typescript": "5.8.3"
  },
  "allowScripts": {
    "bun@1.4.0": true
  }
}
